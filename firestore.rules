rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sadece bu 4 berbere ait Firebase Authentication hesabı "admin" sayılır.
    // Email/Password girişi açık olduğu için "request.auth != null" tek başına
    // yeterli değildir — herkes kendi hesabını oluşturup admin taklidi yapabilir.
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'FKSkj9YuQEaVfyuD82nerIN1YMl1', // fatihtuncer
        'GTeu16aHQNfujiaOe3BS5ULhisJ2', // semsettinsancak
        '1m78pABernS2ScF9VEvNhA3eHOm1', // furkanormankaya
        'ep4UkVrep1epdWX0UmYEiUbyHhk1'  // beratozbakir
      ];
    }

    // Giriş yapan yöneticinin randevu formundaki berber ID'si — bir berberin
    // sadece kendi saatlerini kapatabilmesi için kullanılıyor.
    function ownBarber() {
      return {
        'FKSkj9YuQEaVfyuD82nerIN1YMl1': 'fatihtuncer',
        'GTeu16aHQNfujiaOe3BS5ULhisJ2': 'usta1',
        '1m78pABernS2ScF9VEvNhA3eHOm1': 'usta2',
        'ep4UkVrep1epdWX0UmYEiUbyHhk1': 'usta3'
      }[request.auth.uid];
    }

    match /appointments/{id} {
      // Müşteri formu: herkes randevu oluşturabilir ama sadece geçerli, "pending"
      // durumda ve makul uzunlukta alanlarla.
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.phone.size() <= 30
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.time is string
                    && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
                    && request.resource.data.barber is string;

      // Müsaitlik bilgisi (dolu saatler) Cloud Function üzerinden servis ediliyor —
      // isim/telefon/not gibi kişisel veriler client'a hiç ulaşmıyor.
      // Bu yüzden doğrudan okuma sadece yöneticilere açık.
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /fcmTokens/{token} {
      allow read: if false;
      allow write: if isAdmin();
    }

    match /blockedSlots/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.barber == ownBarber()
                    && request.resource.data.date is string
                    && request.resource.data.time is string;
      allow delete: if isAdmin() && resource.data.barber == ownBarber();
      allow update: if false;
    }
  }
}
